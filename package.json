{
  "type": "module",
  "name": "technology_migration_engine",
  "imports": {
    "#src/*": "./src/*"
  },
  "version": "1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "setup": "npm install && npx patch-package && npm run pre-build --prefix node_modules/@ganezdragon/tree-sitter-perl && npm run build --prefix node_modules/@ganezdragon/tree-sitter-perl",
    "build": "vite build && electron-builder",
    "console": "node --test src/backend/tests/dev.test.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test src/backend/tests/prod",
    "test:frontend": "playwright test",
    "test:frontend:ui": "playwright test --ui",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.dragosstefannecula.technology_migration_engine",
    "productName": "Technology Migration Engine",
    "win": {
      "target": "portable"
    }
  },
  "keywords": [],
  "author": "Dragos-Stefan Necula",
  "license": "ISC",
  "description": "A final year student project attempting to transpile Perl Catalyst into Java Spring MVC using transpiler and LLM methods.",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "patch-package": "^8.0.1",
    "prebuild": "^13.0.1",
    "vite": "^7.2.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ganezdragon/tree-sitter-perl": "^1.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "electron-store": "^11.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tree-sitter": "^0.21.0"
  }
}
