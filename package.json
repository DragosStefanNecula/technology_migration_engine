{
  "type": "module",
  "name": "technology_migration_engine",
  "version": "0.1.0",
  "main": "src/main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "setup": "npm install && npm run pre-build --prefix node_modules/@ganezdragon/tree-sitter-perl && npm run build --prefix node_modules/@ganezdragon/tree-sitter-perl",
    "build": "vite build && electron-builder",
    "test": "node --test",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.dragosstefannecula.technology_migration_engine",
    "win": {
      "target": "portable"
    }
  },
  "keywords": [],
  "author": "Dragos-Stefan Necula",
  "license": "ISC",
  "description": "A final year student project attempting to transpile Perl Catalyst into Java Spring MVC using transpiler and LLM methods.",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "patch-package": "^8.0.1",
    "prebuild": "^13.0.1",
    "vite": "^7.2.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ganezdragon/tree-sitter-perl": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tree-sitter": "^0.21.0"
  }
}
